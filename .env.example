# QontrolAR – variables de entorno (copiar a .env y completar).
# Sólo placeholders: NUNCA versionar .env con valores reales.
# Generar secretos con, por ejemplo:  openssl rand -hex 32
# Usar sólo caracteres [A-Za-z0-9] en contraseñas de Postgres (van dentro de URLs).

# --- Aplicación -------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# URL pública con la que se accede al panel (detrás del proxy HTTPS).
PUBLIC_URL=http://localhost:3000
APP_TIMEZONE=America/Argentina/Buenos_Aires
# En producción detrás de HTTPS: ambos en true.
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_TTL_HOURS=12
OFFLINE_CHECK_INTERVAL_SECONDS=60
INGEST_RATE_LIMIT_PER_MINUTE=120
# 0 = conservar lecturas indefinidamente (ver README sobre plazos de conservación).
READING_RETENTION_DAYS=0


# --- Base de datos de la app (servicio app-db) --------------------------------
APP_POSTGRES_DB=qontrolar
APP_POSTGRES_USER=qontrolar
APP_POSTGRES_PASSWORD=CHANGE_ME_app_db_password
# Sólo para ejecutar con `npm start` fuera de Docker. En Docker Compose la URL
# se arma automáticamente apuntando al servicio app-db.
# Para desarrollo sin Postgres: DATABASE_URL=pglite://./data/pglite
DATABASE_URL=postgres://qontrolar:CHANGE_ME_app_db_password@localhost:5432/qontrolar

# --- WhatsApp vía Evolution API (servicio evolution-api) ----------------------
# Dentro de Docker Compose la app usa http://evolution-api:8080 automáticamente.
EVOLUTION_API_URL=http://localhost:18088
# Evolution API server key. Keep unique; set the app-side key below to the SAME value only when the provider is enabled.
EVOLUTION_API_KEY=CHANGE_ME_evolution_server_key
# App-side API key; blank keeps WhatsApp disabled in QontrolAR until approved provider setup.
QONTROLAR_EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=qontrolar
EVOLUTION_TIMEOUT_MS=10000
# EVOLUTION_IMAGE se deja sin valor por seguridad: activar el perfil `whatsapp`
# sólo con una versión oficial corregida y verificada. La imagen por defecto falla cerrada.
# Sólo localhost: el emparejamiento por QR se hace por túnel SSH (ver README).
EVOLUTION_BIND=127.0.0.1:18088
EVOLUTION_SERVER_URL=http://localhost:8080

# --- Cloudflare Tunnel dedicado a QontrolAR ---------------------------------
# Localmente se deja desactivado. Dokploy define COMPOSE_PROFILES=tunnel y el token real.
COMPOSE_PROFILES=
CLOUDFLARED_TOKEN=CHANGE_ME_tunnel_connector_token

# --- Demo opcional (perfil `demo`, datos ficticios aislados) -----------------
# Sólo para instalaciones de demostración: agregar `demo` a COMPOSE_PROFILES y definir
# DEMO_EMAIL / DEMO_PASSWORD (>= 12 caracteres) ÚNICAMENTE en el entorno de Dokploy.
# No se dejan valores de ejemplo aquí: sin ellos el servicio demo-worker no arranca.
# DEMO_INTERVAL_SECONDS=60

# --- Base de datos de Evolution API (servicio evolution-db, separada) ---------
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=CHANGE_ME_evolution_db_password
